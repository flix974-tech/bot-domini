# Token del bot Telegram (ottienilo da @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# Il tuo user ID Telegram numerico (superadmin).
# Per scoprirlo: scrivi a @userinfobot su Telegram.
SUPERADMIN_ID=123456789

# Percorso del database SQLite (lascia il default se non sai)
DB_PATH=data/bot.db

# Schema dei link generati: http oppure https
LINK_SCHEME=http

# Lunghezza del sottodominio casuale generato
SUBDOMAIN_LENGTH=10
