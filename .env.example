# === Variabili d'ambiente ===
# In produzione vanno impostate nel pannello Vercel (Settings -> Environment Variables).
# In locale, copia questo file in .env per usare `python -m bot.main`.

# Token del bot Telegram (da @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# Il tuo user ID Telegram numerico (superadmin). Scoprilo con @userinfobot.
SUPERADMIN_ID=123456789

# Connessione Postgres.
# Su Vercel viene iniettata AUTOMATICAMENTE come POSTGRES_URL quando colleghi
# un database Vercel Postgres al progetto: NON serve impostarla a mano lì.
# In locale, incolla qui la stringa di connessione (tab ".env.local" del DB su Vercel).
POSTGRES_URL=postgres://utente:password@host:5432/dbname?sslmode=require

# Schema dei link generati: http oppure https
LINK_SCHEME=http

# Lunghezza del sottodominio casuale
SUBDOMAIN_LENGTH=10

# Segreto del webhook (consigliato): una stringa a caso a tua scelta.
# Deve coincidere tra Vercel e la registrazione del webhook su Telegram.
WEBHOOK_SECRET=cambia-questa-stringa-con-una-casuale
